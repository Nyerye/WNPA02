<Window x:Class="WNPA02_Client.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="White"
        Width="800" Height="500">


    <Grid>

        <StackPanel Margin="40" VerticalAlignment="Center">

            <TextBlock Text="ASync Wordle Ripoff"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Developed By:"
                       Margin="0,20,0,5"
                       FontSize="20"
                       Foreground="Black"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Nicholas Reilly"
                       FontSize="22"
                       Foreground="Black"
                       TextAlignment="Center"/>

            <Border Background="White"
                    Padding="20"
                    CornerRadius="8"
                    Margin="0,30,0,0">
                <TextBlock Text=" This is the About Page for our my Windows Network Programmig Assignment 2."
                           Foreground="RoyalBlue"
                           FontSize="16"
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
        <Button Name="ExitBtn" Click="ExitBtn_Click" Content="Exit" HorizontalAlignment="Center" Margin="0,435,0,0" VerticalAlignment="Top" Width="121"/>

    </Grid>
</Window>
